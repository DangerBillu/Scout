# Keep provider credentials on the backend. The local UI does not call the
# model; the adapter reads this only when explicitly invoked by backend code.
HF_TOKEN=
HF_MODEL_ID=Qwen/Qwen3-4B-Thinking-2507
HF_PROVIDER=auto
HF_FALLBACK_MODEL_ID=openai/gpt-oss-120b
HF_FALLBACK_PROVIDER=
HF_MAX_RETRIES=2
HF_REQUEST_TIMEOUT_SECONDS=60

# Yahoo Finance chart feed for the Terminal. It does not require an API key.
# Yahoo may delay or rate-limit data; Scout marks the feed as delayed and
# validates every returned bar. No quote is fabricated when the feed fails.
MARKET_DATA_PROVIDER=yahoo_finance
SCOUT_PAPER_CAPITAL=100000
