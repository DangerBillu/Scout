# Keep provider credentials on the backend. The local UI does not call the
# model; the adapter reads this only when explicitly invoked by backend code.
HF_TOKEN=
HF_MODEL_ID=Qwen/Qwen3-4B-Thinking-2507
HF_PROVIDER=auto
HF_FALLBACK_MODEL_ID=openai/gpt-oss-120b
HF_FALLBACK_PROVIDER=
HF_MAX_RETRIES=2
HF_REQUEST_TIMEOUT_SECONDS=60

# Optional licensed market-data provider for the Terminal. No quote is
# fabricated when this is blank. Confirm the provider's exact index symbols.
MARKET_DATA_PROVIDER=twelvedata
TWELVE_DATA_API_KEY=
TWELVE_DATA_NIFTY50_SYMBOL=NIFTY
TWELVE_DATA_NIFTYBANK_SYMBOL=BANKNIFTY
SCOUT_PAPER_CAPITAL=100000
